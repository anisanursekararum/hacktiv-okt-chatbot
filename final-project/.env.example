# Gemini AI Credentials (free tier default)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# User Authentication (Google OAuth 2.0 or single-user dev mode)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
USER_EMAIL=anisa.arum.work@gmail.com
USER_NAME=Anisa Arum
USER_TIMEZONE=Asia/Jakarta

# Database (PostgreSQL + pgvector connection string, e.g. Neon / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/my_pa_db

# Email Sender & Reminders (Gmail SMTP + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=anisa.arum.work@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="My PA Assistant <anisa.arum.work@gmail.com>"
NEXT_PUBLIC_APP_NAME="My PA"
